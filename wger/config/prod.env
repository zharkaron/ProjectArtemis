#
# wger Workout Manager - Production Environment
#

# Django's secret key
SECRET_KEY=ArtemisWger2026k9mPwLzqR7vNcXfJhG3tY5uB8sE

# The URL where the application will be available
SITE_URL=http://workout.zharkaron.lab

# JWT keys
# Generated on droplet, not committed to git for security
# Run: docker compose exec wger-web python3 manage.py generate-jwt-keys
# after first startup if mobile app access is needed

# Server timezone
TIME_ZONE=America/Caracas
TZ=America/Caracas

# Database
POSTGRES_USER=wger
POSTGRES_PASSWORD=wger_db_s3cure_2026
POSTGRES_DB=wger
PS_DATABASE_URI=postgres://wger:wger_db_s3cure_2026@wger-db:5432/wger
PS_STORAGE_PG_URI=postgres://powersync_storage:powersync_password@wger-db:5432/wger

# Powersync
PS_PORT=8080
POWERSYNC_URL_PATH=ps

# CSRF
CSRF_TRUSTED_ORIGINS=https://workout.zharkaron.lab
X_FORWARDED_PROTO_HEADER_SET=True
USE_X_FORWARDED_HOST=True

# Application settings
ALLOW_REGISTRATION=False
ALLOW_GUEST_USERS=False
ALLOW_UPLOAD_VIDEOS=True
MIN_ACCOUNT_AGE_TO_TRUST=21

# Exercise sync
SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=True
SYNC_EXERCISE_VIDEOS_CELERY=True
SYNC_INGREDIENTS_CELERY=True
SYNC_INGREDIENTS_DUMP_URL=https://wger.de/media/ingredients/ingredients.jsonl.gz
DOWNLOAD_INGREDIENTS_FROM=WGER
CACHE_API_EXERCISES_CELERY=True
CACHE_API_EXERCISES_CELERY_FORCE_UPDATE=False

# Celery
USE_CELERY=True
CELERY_BROKER=redis://wger-cache:6379/2
CELERY_BACKEND=redis://wger-cache:6379/2
CELERY_FLOWER_PASSWORD=adminadmin
CELERY_WORKER_CONCURRENCY=1

# Cache
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://wger-cache:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient

# Brute force protection
AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler
AXES_LOCKOUT_PARAMETERS=ip_address
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_META_PRECEDENCE_ORDER=HTTP_X_FORWARDED_FOR,REMOTE_ADDR

# Django
DJANGO_DEBUG=False
DJANGO_PERFORM_MIGRATIONS=True
DJANGO_COLLECTSTATIC_ON_STARTUP=True
DJANGO_CLEAR_STATIC_FIRST=False

# Gunicorn
WGER_USE_GUNICORN=True
WGER_PORT=8000
GUNICORN_CMD_ARGS="--workers 3 --threads 2 --worker-class gthread --timeout 240"

# JWT auth
ACCESS_TOKEN_LIFETIME=10
REFRESH_TOKEN_LIFETIME=2880

# Auth proxy (disabled)
AUTH_PROXY_HEADER=
AUTH_PROXY_TRUSTED_IPS=
AUTH_PROXY_CREATE_UNKNOWN_USER=False
AUTH_PROXY_USER_EMAIL_HEADER=
AUTH_PROXY_USER_NAME_HEADER=

# Logging
LOG_LEVEL_PYTHON=INFO

# Recaptcha (disabled)
USE_RECAPTCHA=False

# Prometheus (disabled)
EXPOSE_PROMETHEUS_METRICS=False

# Email
FROM_EMAIL=wger Workout Manager <wger@zharkaron.lab>

# Proxies
NUMBER_OF_PROXIES=1

# Cache TTL
EXERCISE_CACHE_TTL=2419200
